
{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "affiliate-marketplace",
  "main": "./worker.js",
  "compatibility_date": "2026-11-21",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "affiliate-marketplace-db",
      "database_id": "eabcb452-e126-432e-8338-6d885ebb87d2"
    }
  ]
}
